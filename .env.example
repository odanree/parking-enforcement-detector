# ── Camera ──────────────────────────────────────────────────────────────────
RTSP_URL=rtsp://admin:password@192.168.1.100:554/stream1
# Force TCP to prevent frame-smearing artifacts (set automatically by rtsp_handler)
RTSP_TRANSPORT=tcp

# ── Detection ────────────────────────────────────────────────────────────────
YOLO_MODEL=yolov8n.pt          # yolov8s.pt for better accuracy at cost of speed
INFERENCE_THRESHOLD=0.65
INPUT_WIDTH=1280
INPUT_HEIGHT=720

# ── VLM Backend ──────────────────────────────────────────────────────────────
# Options: "claude" | "ollama"
VLM_BACKEND=claude

# Claude API (used when VLM_BACKEND=claude)
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (used when VLM_BACKEND=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava:7b-v1.6-mistral-q4_K_M

# ── Alerts ───────────────────────────────────────────────────────────────────
# Home Assistant webhook URL for automation triggers
HA_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/parking-alert
HA_TOKEN=your_long_lived_access_token

# Generic HTTP fallback (leave blank to disable)
ALERT_WEBHOOK_URL=

# ── Test / replay mode ───────────────────────────────────────────────────────
# Set VIDEO_PATH to a local file to bypass RTSP and run the full pipeline
# against recorded footage. Unset (or leave blank) for live camera mode.
VIDEO_PATH=
VIDEO_LOOP=true    # replay the clip continuously
VIDEO_SPEED=1.0    # 1.0 = real-time, 0.5 = half speed (easier to see detections)

# ── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SNAPSHOT_DIR=snapshots
